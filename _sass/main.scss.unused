// Marta Domínguez-Jiménez — site styles (direction 1c)

$paper:        #fbfaf7;
$paper-alt:    #f4f1ea;
$ink:          #161412;
$ink-soft:     #2a2724;
$ink-mid:      #44413c;
$authors:      #55534d;
$muted:        #6C757D;
$rule:         #e6e2db;
$rule-strong:  #e0dbd2;
$rule-faint:   #ece8e0;
$maroon:       #7A1E2C;
$maroon-dark:  #5e1722;
$maroon-pale:  #d8bfc4;

$serif: Newsreader, Georgia, "Times New Roman", serif;
$sans:  "Public Sans", Helvetica, Arial, sans-serif;

$measure: 46rem;   // prose column on wide screens
$shell:   1080px;  // outer container
$gutter:  32px;

*, *::before, *::after { box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  margin: 0;
  background: $paper;
  color: $ink;
  font-family: $sans;
  font-size: 17px;
  line-height: 1.6;
  text-wrap: pretty;
}

a { color: $maroon; }
a:hover { color: $maroon-dark; }

/* ---------- Header ---------- */

.site-header {
  background: $paper-alt;
  border-bottom: 1px solid $rule-strong;
}

.site-header__inner {
  max-width: $shell;
  margin: 0 auto;
  padding: 22px $gutter;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px 24px;
}

.site-title {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.015em;
  line-height: 1.2;
  color: $ink;
  text-decoration: none;
}

.site-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.site-nav a {
  padding: 9px 12px;
  font-size: 14px;
  font-weight: 500;
  color: $ink-mid;
  text-decoration: none;
  border-bottom: 2px solid transparent;
}

.site-nav a:hover { color: $maroon; }
.site-nav a.is-active { color: $maroon; border-bottom-color: $maroon; }

/* ---------- Shell ---------- */

.site-main {
  max-width: $shell;
  margin: 0 auto;
  padding: 48px $gutter 0;
}

.site-footer {
  max-width: $shell;
  margin: 48px auto 0;
  padding: 20px $gutter 44px;
  border-top: 1px solid $rule-strong;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 16px;
  font-size: 12.5px;
  color: $muted;
}

.site-footer a { color: $muted; text-decoration: none; }
.site-footer a:hover { color: $maroon; }

/* ---------- Page furniture ---------- */

.page-label {
  margin: 0 0 28px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: $muted;
}

.section-label {
  margin: 0 0 14px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: $maroon;
}

.prose { max-width: $measure; }

/* ---------- Home ---------- */

.home {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  gap: 56px;
  align-items: start;
}

.home__text { max-width: $measure; }

.home__photo img {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 14 / 15;
  object-fit: cover;
  object-position: 50% 22%;
  border-radius: 2px;
}

.home__caption {
  margin: 10px 0 0;
  font-size: 12px;
  color: $muted;
}

.lede {
  margin: 0 0 22px;
  font-family: $serif;
  font-size: 19px;
  line-height: 1.62;
}

.jm-note {
  margin: 0 0 32px;
  font-family: $serif;
  font-size: 19px;
  font-weight: 500;
  line-height: 1.62;
  color: $maroon;
}

.upcoming h2 {
  margin: 0 0 14px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: $muted;
}

.upcoming__paper {
  padding: 12px 0;
  border-top: 1px solid $rule;
}

.upcoming__title {
  margin: 0 0 7px;
  font-family: $serif;
  font-style: italic;
  font-size: 17px;
  line-height: 1.4;
}

.upcoming__event {
  display: flex;
  gap: 12px;
  margin: 0 0 4px;
  font-size: 13.5px;
}

.upcoming__date {
  flex: 0 0 104px;
  color: $muted;
  font-variant-numeric: tabular-nums;
}

/* ---------- Research ---------- */

.paper {
  padding-bottom: 30px;
  margin-bottom: 30px;
  border-bottom: 1px solid $rule;
}

.paper__title {
  margin: 0 0 8px;
  font-family: $serif;
  font-size: 25px;
  font-weight: 500;
  line-height: 1.3;
}

.paper__authors {
  margin: 0 0 10px;
  font-size: 14.5px;
  color: $authors;
}

.paper__authors a { color: $ink; text-underline-offset: 2px; }

.paper__status {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 0 0 10px;
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: $maroon;
}

.paper__status::before {
  content: "";
  width: 18px;
  height: 2px;
  background: $maroon;
}

.paper__links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 14px;
  font-size: 13px;
  font-weight: 500;
}

.paper__links a {
  color: $maroon;
  text-decoration: none;
  border-bottom: 1px solid $maroon-pale;
  padding-bottom: 2px;
}

.paper__links a:hover { border-bottom-color: $maroon; }

.paper__note {
  margin: 0;
  font-size: 13px;
  font-weight: 500;
  color: $maroon;
}

.paper__presented {
  margin: 14px 0 0;
  font-size: 13px;
  font-style: italic;
  line-height: 1.55;
  color: $muted;
}

.paper__presented strong { font-style: normal; font-weight: 600; }

/* Abstract disclosure — works with JavaScript off */

.abstract { margin-top: 16px; }

.abstract > summary {
  display: flex;
  align-items: center;
  gap: 9px;
  list-style: none;
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: $maroon;
}

.abstract > summary::-webkit-details-marker { display: none; }

.abstract > summary::before {
  content: "+";
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  border: 1px solid $maroon-pale;
  font-size: 12px;
  line-height: 1;
}

.abstract[open] > summary::before { content: "\2013"; }
.abstract > summary:hover { text-decoration: underline; }

.abstract__body {
  margin: 16px 0 0;
  font-family: $serif;
  font-size: 16px;
  line-height: 1.65;
  color: $ink-soft;
  text-align: justify;
  hyphens: auto;
}

/* ---------- CV ---------- */

.cv-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 30px;
}

.cv-download {
  background: $maroon;
  color: $paper;
  padding: 10px 14px;
  border-radius: 2px;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
}

.cv-download:hover { background: $maroon-dark; color: $paper; }

.cv-section { margin-bottom: 28px; }

.cv-row {
  display: flex;
  gap: 20px;
  align-items: baseline;
  padding: 8px 0;
  border-top: 1px solid $rule-faint;
}

.cv-row__main { flex: 1 1 auto; min-width: 0; }

.cv-row__title {
  font-family: $serif;
  font-size: 16px;
  font-weight: 500;
  line-height: 1.45;
}

.cv-row__sub {
  display: block;
  font-size: 13px;
  color: $muted;
}

.cv-row__right {
  flex: 0 0 auto;
  font-size: 13px;
  color: $muted;
  font-variant-numeric: tabular-nums;
}

.cv-bullet {
  display: flex;
  gap: 10px;
  margin: 4px 0;
  font-size: 13.5px;
  line-height: 1.55;
  color: $ink-mid;
}

.cv-bullet::before { content: "\2014"; color: #b9b3a8; }

/* ---------- Policy publications ---------- */

.pub {
  display: flex;
  gap: 18px;
  padding: 12px 0;
  border-top: 1px solid $rule-faint;
}

.pub__main { flex: 1 1 auto; min-width: 0; }

.pub__title {
  margin: 0 0 3px;
  font-family: $serif;
  font-size: 15.5px;
  line-height: 1.5;
}

.pub__title--book { font-size: 17px; font-weight: 500; }

.pub__translation {
  margin: 0 0 5px;
  font-family: $serif;
  font-style: italic;
  font-size: 14.5px;
  color: $muted;
}

.pub__meta {
  margin: 0;
  font-size: 13px;
  color: $muted;
}

.pub__year {
  flex: 0 0 auto;
  font-size: 13px;
  color: $muted;
  font-variant-numeric: tabular-nums;
}

/* ---------- Narrow screens ---------- */

@media (max-width: 820px) {
  .home { grid-template-columns: 1fr; gap: 32px; }
  .home__photo img { max-width: 300px; }
  .site-header__inner { padding: 18px 20px; }
  .site-main { padding: 32px 20px 0; }
  .site-footer { padding: 20px 20px 36px; justify-content: flex-start; }
  .upcoming__event { flex-wrap: wrap; }
  .upcoming__date { flex: 0 0 auto; }
  .abstract__body { text-align: left; }
}

/* ---------- Print ---------- */

@media print {
  body { background: #fff; }
  .site-header, .site-nav, .site-footer { background: none; border: 0; }
  .abstract > summary { display: none; }
  .abstract > .abstract__body { display: block !important; }
}